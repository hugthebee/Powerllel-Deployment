{
 "objectIdFieldName": "FID",
 "uniqueIdField": {
  "name": "FID",
  "isSystemMaintained": true
 },
 "globalIdFieldName": "",
 "geometryType": "esriGeometryPoint",
 "spatialReference": {
  "wkid": 4326,
  "latestWkid": 4326
 },
 "fields": [
  {
   "name": "Plant_Code",
   "type": "esriFieldTypeInteger",
   "alias": "Energy Information Administration (EIA) Power Plant Identification Number",
   "sqlType": "sqlTypeInteger",
   "domain": null,
   "defaultValue": null,
   "description": "{\"value\":\"A unique identification number assigned by the Energy Information Administration (EIA) to each power plant. This identifier is used across EIA surveys and reporting systems.\",\"fieldValueType\":\"uniqueIdentifier\"}"
  },
  {
   "name": "Plant_Name",
   "type": "esriFieldTypeString",
   "alias": "Electric Power Plant Name",
   "sqlType": "sqlTypeNVarchar",
   "length": 58,
   "domain": null,
   "defaultValue": null,
   "description": "{\"value\":\"The official name of the electric power plant as reported to the Energy Information Administration (EIA). Plant names are used for identification, reporting, and public reference.\",\"fieldValueType\":\"nameOrTitle\"}"
  },
  {
   "name": "Utility_Na",
   "type": "esriFieldTypeString",
   "alias": "Operating Utility Name",
   "sqlType": "sqlTypeNVarchar",
   "length": 65,
   "domain": null,
   "defaultValue": null,
   "description": "{\"value\":\"The name of the utility responsible for day-to-day operations of the power plant. This field reflects operational control rather than ownership in all cases.\",\"fieldValueType\":\"nameOrTitle\"}"
  },
  {
   "name": "PrimSource",
   "type": "esriFieldTypeString",
   "alias": "Primary Energy Source",
   "sqlType": "sqlTypeNVarchar",
   "length": 14,
   "domain": null,
   "defaultValue": null,
   "description": "{\"value\":\"The primary fuel or energy source used by the power plant for electricity generation. This field reflects the dominant source reported to the Energy Information Administration (EIA).\",\"fieldValueType\":\"typeOrCategory\"}"
  },
  {
   "name": "tech_desc",
   "type": "esriFieldTypeString",
   "alias": "Generation Technology Description",
   "sqlType": "sqlTypeNVarchar",
   "length": 130,
   "domain": null,
   "defaultValue": null,
   "description": "{\"value\":\"A description of the generation technologies or prime movers used at the plant. Technology types describe how electricity is produced from energy sources.\",\"fieldValueType\":\"description\"}"
  },
  {
   "name": "Total_MW",
   "type": "esriFieldTypeDouble",
   "alias": "Maximum Summer Capacity (Megawatts)",
   "sqlType": "sqlTypeFloat",
   "domain": null,
   "defaultValue": null,
   "description": "{\"value\":\"The maximum electrical output of the plant during summer conditions, measured in megawatts. Summer capacity accounts for performance limits due to temperature and operating conditions.\",\"fieldValueType\":\"measurement\"}"
  },
  {
   "name": "Coal_MW",
   "type": "esriFieldTypeDouble",
   "alias": "Coal-Fired Generation Capacity (Megawatts)",
   "sqlType": "sqlTypeFloat",
   "domain": null,
   "defaultValue": null,
   "description": "{\"value\":\"The net summer capacity of coal-fired electric generators at the plant. Coal capacity represents conventional thermal generation resources.\",\"fieldValueType\":\"measurement\"}"
  },
  {
   "name": "NG_MW",
   "type": "esriFieldTypeDouble",
   "alias": "Natural Gas Generation Capacity (Megawatts)",
   "sqlType": "sqlTypeFloat",
   "domain": null,
   "defaultValue": null,
   "description": "{\"value\":\"The net summer capacity of natural gas-fired electric generators at the plant. Natural gas is a major fuel source for electricity generation in the United States.\",\"fieldValueType\":\"measurement\"}"
  },
  {
   "name": "Nuclear_MW",
   "type": "esriFieldTypeDouble",
   "alias": "Nuclear Generation Capacity (Megawatts)",
   "sqlType": "sqlTypeFloat",
   "domain": null,
   "defaultValue": null,
   "description": "{\"value\":\"The net summer capacity of nuclear-powered electric generators at the plant. Nuclear capacity reflects baseload electricity generation resources.\",\"fieldValueType\":\"measurement\"}"
  },
  {
   "name": "County",
   "type": "esriFieldTypeString",
   "alias": "Plant County Location",
   "sqlType": "sqlTypeNVarchar",
   "length": 25,
   "domain": null,
   "defaultValue": null,
   "description": "{\"value\":\"The county containing the power plant. County names are used for sub-state analysis and reporting.\",\"fieldValueType\":\"locationOrPlaceName\"}"
  }
 ],
